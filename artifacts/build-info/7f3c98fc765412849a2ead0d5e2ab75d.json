		"sources": {
			"contracts/types/DeworkTypes.sol": {
				"content": "// SPDX-License-Identifier: GPL-3.0\npragma solidity >=0.8.2 <0.9.0;\n\nstruct FreelancerProfile{\n    uint256 id;\n    string name;\n    address wallet;\n    uint8 experienceYears;\n    bool isAvailableHire;\n    uint256 hourlyRateWei; // 1 ether = 10^18 wei\n}\n\nstruct EmployerProfile{\n    uint256 id;\n    string name;\n    bool isHiring;\n    address wallet;\n    JobListing[] jobListing;\n}\n\nstruct CreateJobListingInput{\n    string title;\n    string jobDescription;\n    uint256 deadlineTimestamp;\n    uint256 fixedPriceInWei;\n}\n\nstruct JobListing {\n    uint256 id;\n    string title;\n    string description;\n    uint256 deadlineTimestamp;\n    bool isOpen;\n    uint256 fixedPriceInWei;\n    uint256 hiredFreelancerId;\n    bool hasHiredFreelancer;\n    bool isPaid;\n}"
			}
		}
	},
